{
    "name": "phpfasty/wpmodules",
    "description": "ModulY for WordPress: the plugin (moduly/) and its modules (modules/).",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [{ "name": "PHP FastY", "homepage": "https://github.com/phpfasty" }],
    "require": { "php": ">=8.2" },
    "require-dev": {
        "paragonie/sodium_compat": "^2.1",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload-dev": {
        "psr-4": {
            "PhpFasty\\Moduly\\Wp\\": "moduly/src/",
            "PhpFasty\\Moduly\\": "moduly/lib/core/src/",
            "PhpFasty\\Module\\Cart\\": "modules/cart/src/",
            "PhpFasty\\Module\\Orders\\": "modules/orders/src/",
            "PhpFasty\\Module\\Types\\": "modules/types/src/",
            "PhpFasty\\Module\\Downloads\\": "modules/downloads/src/",
            "PhpFasty\\Module\\ConsentLog\\": "modules/consent-log/src/",
            "PhpFasty\\Module\\CookieConsent\\": "modules/cookie-consent/src/",
            "PhpFasty\\WpModules\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "phpcs": "phpcs"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true, "phpstan/extension-installer": true }
    }
}
