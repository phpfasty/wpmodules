<?xml version="1.0"?>
<ruleset name="wpmodules">
    <description>PSR-12 code style plus WordPress security sniffs (escaping, nonces, sanitized input, prepared SQL).</description>
    <file>moduly/moduly.php</file>
    <file>moduly/autoload.php</file>
    <file>moduly/src</file>
    <file>modules</file>
    <file>tests</file>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <properties><property name="lineLimit" value="140"/></properties>
    </rule>
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
        <!-- exception messages are escaped where they are printed (admin notices, REST JSON, WP-CLI) -->
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.Security">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
